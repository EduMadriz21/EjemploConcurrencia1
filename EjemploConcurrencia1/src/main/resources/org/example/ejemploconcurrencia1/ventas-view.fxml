<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ejemploconcurrencia1.controller.VentasController"
            prefHeight="600.0"
            prefWidth="760.0"
            style="-fx-background-color: #f7f7f7;">

    <children>

        <VBox spacing="14.0"
              AnchorPane.topAnchor="25.0"
              AnchorPane.bottomAnchor="25.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0">

            <padding>
                <Insets top="5.0"
                        right="5.0"
                        bottom="5.0"
                        left="5.0"/>
            </padding>

            <!-- TITULO -->

            <Label text="Procesamiento Concurrente de Ventas"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222222;"/>


            <!-- VENDEDOR 1 -->

            <VBox spacing="5.0"
                  style="-fx-border-color: #e5a82d;
                         -fx-border-width: 3;
                         -fx-padding: 7;
                         -fx-background-color: #ffffff;">

                <Label text="Vendedor 1"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblVendedor1"
                       text="Esperando..."
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #666666;"/>

                <ProgressBar fx:id="pbVendedor1"
                             progress="0.0"
                             prefWidth="680.0"/>

            </VBox>


            <!-- VENDEDOR 2 -->

            <VBox spacing="5.0"
                  style="-fx-padding: 7;">

                <Label text="Vendedor 2"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblVendedor2"
                       text="Esperando..."
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #666666;"/>

                <ProgressBar fx:id="pbVendedor2"
                             progress="0.0"
                             prefWidth="680.0"/>

            </VBox>


            <!-- VENDEDOR 3 -->

            <VBox spacing="5.0"
                  style="-fx-padding: 7;">

                <Label text="Vendedor 3"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblVendedor3"
                       text="Esperando..."
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #666666;"/>

                <ProgressBar fx:id="pbVendedor3"
                             progress="0.0"
                             prefWidth="680.0"/>

            </VBox>


            <Separator prefWidth="680.0"/>


            <!-- TOTALES -->

            <HBox spacing="15.0"
                  alignment="CENTER_LEFT">

                <Label fx:id="lblCantidadVentas"
                       text="Cantidad de ventas: 0"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="lblTotal"
                       text="Total recaudado: C$ 0"
                       style="-fx-font-weight: bold;"/>

            </HBox>


            <!-- REGISTRO DE VENTAS -->

            <TextArea fx:id="txtRegistro"
                      editable="false"
                      wrapText="true"
                      prefHeight="170.0"
                      prefWidth="680.0"
                      promptText="Aquí aparecerán las ventas procesadas..."/>


            <!-- BOTONES -->

            <HBox spacing="10.0">

                <Button fx:id="btnIniciar"
                        text="Iniciar ventas"
                        prefWidth="110.0"
                        onAction="#iniciarVentas"
                        style="-fx-font-weight: bold;"/>

                <Button text="Limpiar"
                        prefWidth="80.0"
                        onAction="#limpiar"/>

            </HBox>

        </VBox>

    </children>

</AnchorPane>